# === LLM & Embeddings (OpenAI-compatible, Open-Weight Apache 2.0 <= 128GB VRAM) ===
LLM_BASE_URL=https://api.proxyapi.ru/v1
LLM_API_KEY=your_api_key_here
LLM_MODEL=qwen/qwen3-30b-a3b-instruct-2507
EMBEDDING_MODEL=qwen/qwen3-embedding-4b

# Для локального запуска (--profile local):
# LLM_BASE_URL=http://ollama:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen3:30b-a3b
# EMBEDDING_MODEL=qwen3-embedding:4b

# === Storage ===
QDRANT_URL=http://qdrant:6333
SQLITE_PATH=/app/data/app.db
DOCS_DIR=/app/docs

# === Email HITL (SMTP + IMAP) ===
SMTP_HOST=mail
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USE_SSL=false
IMAP_HOST=mail
IMAP_PORT=993
IMAP_USE_SSL=true
MAIL_VALIDATE_CERTS=false

BOT_EMAIL=bot@corp.local
BOT_EMAIL_PASSWORD=BotPass2026!
QUALITY_EMAIL=quality@corp.local
QUALITY_WHITELIST=quality@corp.local
DEFAULT_EMPLOYEE_EMAIL=employee@corp.local
IMAP_POLL_INTERVAL_SECONDS=10

# === Public URLs ===
SERVER_IP=139.100.218.28
PUBLIC_URL=https://139-100-218-28.sslip.io
WEBMAIL_URL=https://139-100-218-28.sslip.io/webmail/
